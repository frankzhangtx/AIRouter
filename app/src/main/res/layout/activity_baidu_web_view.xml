<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/baidu_web_input_reserved_bottom_space" />

        <LinearLayout
            android:id="@+id/bottom_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/input_bar_surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/input_top_extension"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/baidu_web_input_top_extension_height"
                    android:importantForAccessibility="no"
                    android:orientation="vertical"
                    android:translationY="-15dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/baidu_web_input_top_extension_fade_height"
                        android:background="@drawable/bg_baidu_web_input_top_extension" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/baidu_web_input_top_extension_solid_height"
                        android:background="@color/baidu_web_input_background" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bottom_input_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/baidu_web_input_horizontal_margin"
                    android:layout_marginEnd="@dimen/baidu_web_input_horizontal_margin"
                    android:background="@drawable/bg_baidu_web_input_bar"
                    android:elevation="8dp"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/baidu_web_input_height"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingStart="12dp"
                    android:paddingBottom="8dp"
                    android:paddingEnd="12dp">

                <ImageButton
                    android:id="@+id/button_voice_input"
                    android:layout_width="@dimen/baidu_web_input_icon_size"
                    android:layout_height="@dimen/baidu_web_input_icon_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/baidu_web_voice_content_description"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="@dimen/baidu_web_input_icon_padding"
                    android:scaleType="center"
                    android:src="@drawable/ic_baidu_web_voice" />

                <EditText
                    android:id="@+id/edit_text_consult_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="start|center_vertical"
                    android:hint="@string/baidu_web_input_hint"
                    android:imeOptions="actionSend"
                    android:includeFontPadding="false"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:minLines="1"
                    android:overScrollMode="never"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:scrollbars="none"
                    android:singleLine="false"
                    android:textColor="@color/black"
                    android:textColorHint="@color/baidu_web_input_hint"
                    android:textSize="@dimen/baidu_web_input_text_size" />

                <ImageButton
                    android:id="@+id/button_add_content"
                    android:layout_width="@dimen/baidu_web_input_icon_size"
                    android:layout_height="@dimen/baidu_web_input_icon_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/baidu_web_plus_content_description"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="@dimen/baidu_web_input_icon_padding"
                    android:scaleType="center"
                    android:src="@drawable/ic_baidu_web_plus" />
                </LinearLayout>
            </FrameLayout>

            <View
                android:id="@+id/input_bottom_fill"
                android:layout_width="match_parent"
                android:layout_height="@dimen/baidu_web_input_bottom_margin" />

            <LinearLayout
                android:id="@+id/input_attachment_panel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/baidu_web_attachment_panel_height"
                android:gravity="top|start"
                android:orientation="horizontal"
                android:paddingTop="@dimen/baidu_web_attachment_panel_top_padding"
                android:paddingStart="@dimen/baidu_web_attachment_panel_horizontal_padding"
                android:paddingBottom="@dimen/baidu_web_attachment_panel_bottom_padding"
                android:paddingEnd="@dimen/baidu_web_attachment_panel_horizontal_padding"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/option_attach_image"
                    android:layout_width="@dimen/baidu_web_attachment_option_width"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/baidu_web_attachment_option_gap"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/baidu_web_attachment_icon_tile_size"
                        android:layout_height="@dimen/baidu_web_attachment_icon_tile_size"
                        android:background="@drawable/bg_baidu_web_attachment_icon_tile"
                        android:contentDescription="@string/baidu_web_attachment_image"
                        android:padding="@dimen/baidu_web_attachment_icon_padding"
                        android:src="@drawable/ic_baidu_web_attachment_image" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/baidu_web_attachment_label_top_margin"
                        android:includeFontPadding="false"
                        android:text="@string/baidu_web_attachment_image"
                        android:textColor="@color/baidu_web_attachment_text"
                        android:textSize="@dimen/baidu_web_attachment_text_size" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/option_send_product"
                    android:layout_width="@dimen/baidu_web_attachment_option_width"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/baidu_web_attachment_icon_tile_size"
                        android:layout_height="@dimen/baidu_web_attachment_icon_tile_size"
                        android:background="@drawable/bg_baidu_web_attachment_icon_tile"
                        android:contentDescription="@string/baidu_web_attachment_product"
                        android:padding="@dimen/baidu_web_attachment_icon_padding"
                        android:src="@drawable/ic_baidu_web_attachment_product" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/baidu_web_attachment_label_top_margin"
                        android:includeFontPadding="false"
                        android:text="@string/baidu_web_attachment_product"
                        android:textColor="@color/baidu_web_attachment_text"
                        android:textSize="@dimen/baidu_web_attachment_text_size" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
