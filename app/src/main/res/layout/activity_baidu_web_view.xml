<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/manual_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="@dimen/baidu_web_manual_toggle_top_margin"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/manual_mode_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_toggle_voice_record_panel"
                    android:layout_width="wrap_content"
                    android:layout_height="36.4dp"
                    android:elevation="4dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/baidu_web_switch_to_old_voice_panel"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="8sp"
                    app:backgroundTint="@color/baidu_web_input_background"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/baidu_web_input_stroke"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_toggle_manual"
                    android:layout_width="wrap_content"
                    android:layout_height="36.4dp"
                    android:layout_marginStart="4dp"
                    android:elevation="4dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="@string/baidu_web_toggle_manual_enter"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="8sp"
                    app:backgroundTint="@color/baidu_web_input_background"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/baidu_web_input_stroke"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_toggle_manual_online"
                android:layout_width="wrap_content"
                android:layout_height="36.4dp"
                android:layout_marginTop="4dp"
                android:elevation="4dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:text="@string/baidu_web_manual_online"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="8sp"
                app:backgroundTint="@color/baidu_web_input_background"
                app:cornerRadius="14dp"
                app:strokeColor="@color/baidu_web_input_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_toggle_manual_agent_type"
                android:layout_width="wrap_content"
                android:layout_height="36.4dp"
                android:layout_marginTop="4dp"
                android:elevation="4dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:text="@string/baidu_web_manual_type_online_service"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="8sp"
                app:backgroundTint="@color/baidu_web_input_background"
                app:cornerRadius="14dp"
                app:strokeColor="@color/baidu_web_input_stroke"
                app:strokeWidth="1dp" />

            <LinearLayout
                android:id="@+id/suggestion_list_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_append_suggestion_items"
                    android:layout_width="wrap_content"
                    android:layout_height="36.4dp"
                    android:elevation="4dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/baidu_web_append_suggestion_items"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="8sp"
                    app:backgroundTint="@color/baidu_web_input_background"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/baidu_web_input_stroke"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_toggle_suggestion_list"
                    android:layout_width="wrap_content"
                    android:layout_height="36.4dp"
                    android:layout_marginStart="4dp"
                    android:elevation="4dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="@string/baidu_web_add_suggestion_list"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="8sp"
                    app:backgroundTint="@color/baidu_web_input_background"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/baidu_web_input_stroke"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_replace_suggestion_items"
                    android:layout_width="wrap_content"
                    android:layout_height="36.4dp"
                    android:layout_marginStart="4dp"
                    android:elevation="4dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/baidu_web_replace_suggestion_items"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="8sp"
                    app:backgroundTint="@color/baidu_web_input_background"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/baidu_web_input_stroke"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_toggle_bottom_overlay"
                android:layout_width="wrap_content"
                android:layout_height="36.4dp"
                android:layout_marginTop="4dp"
                android:elevation="4dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:text="@string/baidu_web_show_bottom_overlay"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="8sp"
                app:backgroundTint="@color/baidu_web_input_background"
                app:cornerRadius="14dp"
                app:strokeColor="@color/baidu_web_input_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_get_bottom_panel_height"
                android:layout_width="wrap_content"
                android:layout_height="36.4dp"
                android:layout_marginTop="4dp"
                android:elevation="4dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:text="@string/baidu_web_get_bottom_panel_height"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="8sp"
                app:backgroundTint="@color/baidu_web_input_background"
                app:cornerRadius="14dp"
                app:strokeColor="@color/baidu_web_input_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_toggle_bottom_panel_visibility"
                android:layout_width="wrap_content"
                android:layout_height="36.4dp"
                android:layout_marginTop="4dp"
                android:elevation="4dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:text="@string/baidu_web_show_bottom_panel"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="8sp"
                app:backgroundTint="@color/baidu_web_input_background"
                app:cornerRadius="14dp"
                app:strokeColor="@color/baidu_web_input_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_toggle_bottom_panel_layer"
                android:layout_width="wrap_content"
                android:layout_height="36.4dp"
                android:layout_marginTop="4dp"
                android:elevation="4dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:text="@string/baidu_web_bottom_panel_layer_above"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="8sp"
                app:backgroundTint="@color/baidu_web_input_background"
                app:cornerRadius="14dp"
                app:strokeColor="@color/baidu_web_input_stroke"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <com.example.cctest.widget.BottomInputPanelView
            android:id="@+id/bottom_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone" />

        <View
            android:id="@+id/bottom_input_overlay"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="bottom"
            android:background="@color/baidu_web_bottom_input_overlay"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
