<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/baidu_web_suggestion_chip_item_height"
    android:layout_marginEnd="@dimen/baidu_web_suggestion_chip_gap"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/suggestion_chip_body"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/baidu_web_suggestion_chip_height"
        android:layout_gravity="bottom|start"
        android:background="@drawable/bg_baidu_web_suggestion_chip"
        android:elevation="@dimen/baidu_web_suggestion_chip_shadow_elevation"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/baidu_web_suggestion_chip_start_padding"
        android:paddingEnd="@dimen/baidu_web_suggestion_chip_end_padding">

        <ImageView
            android:id="@+id/suggestion_chip_icon"
            android:layout_width="@dimen/baidu_web_suggestion_chip_icon_size"
            android:layout_height="@dimen/baidu_web_suggestion_chip_icon_size"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/suggestion_chip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/baidu_web_suggestion_chip_icon_gap"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/baidu_web_suggestion_chip_text"
            android:textSize="@dimen/baidu_web_suggestion_chip_text_size" />
    </LinearLayout>
</FrameLayout>
